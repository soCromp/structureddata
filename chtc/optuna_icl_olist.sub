# optuna_swarm.sub
universe = vanilla
executable = run_optuna_worker.sh

# Pass the dataset and model type as arguments to the bash script
arguments = olist tabby

# Standard CHTC logging
log = logs/optuna_$(Cluster)_$(Process).log
error = logs/optuna_$(Cluster)_$(Process).err
output = logs/optuna_$(Cluster)_$(Process).out

# Request standard GPU resources (adjust based on Tabby's exact needs)
request_cpus = 4
request_memory = 16GB
request_disk = 20GB
request_gpus = 1

# THE MAGIC LINE: This tells CHTC to spawn 20 independent jobs using the exact setup above
queue 20